{
  "name": "math-diagnostic-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "biome lint src server shared tests scripts --error-on-warnings",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:curriculum": "node --import tsx scripts/verify-curriculum.ts",
    "verify:ai": "node --import tsx scripts/verify-ai.ts",
    "check:env": "node --import tsx scripts/check-env.ts",
    "build:server": "esbuild api/[...path].ts --platform=node --bundle --packages=external --format=esm --outdir=.server-check",
    "scan:build": "node --import tsx scripts/scan-build.ts",
    "prebuild": "node --import tsx scripts/production-gate.ts"
  },
  "dependencies": {
    "@google/genai": "2.10.0",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-mathematics": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/katex": "^0.16.8",
    "@vitejs/plugin-react": "^6.1.1",
    "docx": "9.15.0",
    "dotenv": "^17.2.3",
    "jszip": "^3.10.2",
    "katex": "0.18.10",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "1.17.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "0.35.5",
    "vite": "^8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.14.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "pg": "8.23.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
