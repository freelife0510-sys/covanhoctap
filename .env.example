# Server only. Never prefix secrets with VITE_. Use separate Preview/Production projects.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
# Discover and smoke-test a model using npm run verify:ai before configuring it.
GEMINI_PRIMARY_MODEL=
GEMINI_FALLBACK_MODELS=
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=8192
# Owner must set budgets explicitly before AI requests are enabled.
AI_DAILY_REQUEST_LIMIT_PER_USER=
AI_GLOBAL_DAILY_TOKEN_LIMIT=
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PDF_PAGES=20
